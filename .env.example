# Paths to index
TARGET_REPO_PATH=/path/to/your/repo
PDF_SOURCE_DIR=./sample_docs

# Storage
CHROMA_PERSIST_DIR=./chroma_store
INDEX_REGISTRY_PATH=./registry.json

# Models
EMBEDDING_MODEL=nomic-embed-text
LLM_MODEL=qwen2.5-coder:14b
OLLAMA_BASE_URL=http://localhost:11434

# Metadata extraction — runs once per new PDF/CSV at ingest time, writes .meta.yaml sidecar
EXTRACT_METADATA=true
EXTRACT_METADATA_MODEL=qwen2.5-coder:14b  # can use a smaller/faster model here
EXTRACT_METADATA_CHARS=3000               # characters of document text fed to the extractor

# Ingestion
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
FORCE_REINDEX=false

# Retrieval
NUM_RETRIEVED_CHUNKS=5
SEMANTIC_WEIGHT=0.6
KEYWORD_WEIGHT=0.4
