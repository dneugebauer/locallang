# Paths to index
TARGET_REPO_PATH=/path/to/your/repo
PDF_SOURCE_DIR=/path/to/pdfs

# Storage
CHROMA_PERSIST_DIR=./chroma_store
INDEX_REGISTRY_PATH=./registry.json

# Models
EMBEDDING_MODEL=nomic-embed-text
LLM_MODEL=qwen2.5-coder:14b
OLLAMA_BASE_URL=http://localhost:11434

# Ingestion
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
FORCE_REINDEX=false

# Retrieval
NUM_RETRIEVED_CHUNKS=5
SEMANTIC_WEIGHT=0.6
KEYWORD_WEIGHT=0.4
